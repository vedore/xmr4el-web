---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';

const {
  title = 'XMR4EL',
  description = 'XMR4EL treats entity linking as extreme multi-label ranking: a learned tree of concepts decides which of thousands of IDs are worth ranking for each mention.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Share card (LinkedIn, etc.): absolute URLs; public/og.png is 1200×627
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${base}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline>
      // Light unless the visitor picked dark with the toggle
      let t; try { t = localStorage.getItem('theme'); } catch {}
      document.documentElement.dataset.theme = t || 'light';
    </script>
    <style is:global>
      /* Cool gray / slate page; terracotta accent from the XMR4EL palette */
      :root {
        color-scheme: light;
        --bg: #F6F8FA; --surface: #EAEEF2; --text: #1C2330; --muted: #55606E; --line: #D8DEE6;
        --accent: #B8492A; --bar: #8792A0;
        --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --bg: #10151C; --surface: #1A212B; --text: #E6EAF0; --muted: #9AA5B3; --line: #2A3340;
        --accent: #CC7D65; --bar: #5A6573;
      }
      :root[data-theme='light'] { color-scheme: light; }

      * { box-sizing: border-box; }
      html { scroll-padding-top: 4.5rem; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 1.0625rem/1.65 var(--sans); }
      a { color: var(--accent); }
      main { padding: 0 16px; container-type: inline-size; }
      main > * { max-width: 52rem; margin-inline: auto; }
      main > .wide { max-width: 84rem; }
      section { margin-bottom: 4rem; }
      h1, h2, h3 { line-height: 1.25; font-weight: 600; }

      .site-header { position: sticky; top: 0; z-index: 1; background: var(--bg); border-bottom: 1px solid var(--line); }
      .site-header > div { max-width: 84rem; margin: 0 auto; padding: 0.75rem 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.5rem; }
      .wordmark { font: 600 1.1rem var(--mono); color: var(--text); text-decoration: none; }
      .wordmark .word span { color: var(--accent); }
      /* Tree icon (same drawing as public/favicon.svg) beside the name */
      .wordmark { display: flex; align-items: center; gap: 0.45em; }
      .wordmark svg { width: 1.5em; height: 1.5em; order: -1; }
      .site-header nav { flex: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.5rem; font: 0.9rem var(--mono); }
      .site-header nav div { display: flex; gap: 0.25rem 1.75rem; }
      .site-header .ext { margin-left: auto; gap: 1.25rem; }
      .site-header nav a { color: var(--muted); text-decoration: none; }
      .site-header nav a:hover, .site-header nav a[aria-current] { color: var(--accent); }
      @media (max-width: 760px) {
        /* Wordmark, Benchmarks, GitHub and toggle fit one row at 375px */
        .site-header > div { gap: 0.25rem 0.75rem; }
        .site-header .sections { display: none; }
        .site-header nav { font-size: 0.8rem; }
        .site-header .ext { gap: 0.9rem; }
        .wordmark { font-size: 1rem; }
      }
      /* Bulb: lit in light mode, off in dark mode */
      #theme-toggle { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0; color: var(--muted); background: none; border: 0; cursor: pointer; }
      #theme-toggle:hover { color: var(--accent); }
      #theme-toggle svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: filter 0.7s ease; }
      #theme-toggle .glass { transition: fill 0.7s ease; }
      :root[data-theme='light'] #theme-toggle svg { filter: drop-shadow(0 0 5px rgb(245 190 90 / 0.8)); }
      :root[data-theme='light'] #theme-toggle .glass { fill: #F5C66B; }
      /* Theme switch: the new lighting fades in over the old one, like a dimmer */
      ::view-transition-old(root) { animation: none; }
      ::view-transition-new(root) { animation: 0.7s ease-in-out both theme-fade; }
      @keyframes theme-fade { from { opacity: 0; } }

      #demo h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); line-height: 1.15; max-width: 22ch; margin: 2.5rem 0 2rem; }
      .stage { display: grid; grid-template-columns: minmax(0, 7fr) minmax(16rem, 3fr); gap: 3rem; align-items: start; }
      .player { display: block; width: 100%; aspect-ratio: 1408 / 790; background: var(--surface); border: 1px solid var(--line); }
      .eyebrow { font: 0.78rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 0.6rem; }
      .screens { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .screens li { border-bottom: 1px solid var(--line); }
      .screens button { display: block; width: 100%; text-align: left; font: inherit; color: inherit; background: none; border: 0; border-left: 3px solid transparent; padding: 0.7rem 0.6rem; cursor: pointer; }
      .screens button:hover { background: var(--surface); }
      .screens button[aria-current] { border-left-color: var(--accent); }
      .screens b { display: block; font: 600 0.98rem/1.4 var(--mono); }
      /* Only the playing screen shows its description, so the list stays shorter than the video */
      .screens small { display: block; color: var(--muted); font-size: 0.9rem; line-height: 1.45; max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.4s ease, opacity 0.4s ease, margin-top 0.4s ease; }
      .screens [aria-current] small { max-height: 5em; opacity: 1; margin-top: 0.15rem; }
      /* Prev/next arrows: phones only, step through the screens */
      .step { display: none; flex: none; width: 2.75rem; height: 2.75rem; font: 600 1.2rem var(--mono); color: var(--accent); background: none; border: 0; cursor: pointer; }
      .step:hover { opacity: 0.7; }
      .tour-bar { display: none; }
      @media (max-width: 760px) {
        /* Phone: drop the screen list; the playing screen's entry becomes a plain caption under the video:
           numbered name label (like the section headings) with quiet ← → at its end, description below */
        .stage { grid-template-columns: 1fr; gap: 0.75rem; }
        .showcase .eyebrow, .screens li:not(:has([aria-current])) { display: none; }
        .showcase { display: grid; grid-template-columns: 1fr auto auto; }
        .screens { grid-area: 1 / 1 / 2 / -1; border: 0; touch-action: pan-y; }
        .screens li { border: 0; animation: caption-in 0.4s ease; }
        .screens button { pointer-events: none; border: 0; padding: 0.6rem 0 0; }
        .screens b { padding-right: 6.5rem; line-height: 1.4; min-height: 2.75rem; display: flex; align-items: center; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; }
        .screens b::before { content: attr(data-n) ' / 07\2002' / ''; color: var(--accent); }
        .screens small { font-size: 0.95rem; }
        .screens [aria-current] small { max-height: 6em; margin-top: 0.3rem; }
        /* 44px round buttons; above the caption, which spans their row */
        .step { display: grid; place-items: center; position: relative; z-index: 1; grid-row: 1; grid-column: 2; margin: 0.6rem 0 0 0.4rem; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius: 50%; }
        .step svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .step:hover, .step:active { background: color-mix(in srgb, var(--accent) 22%, transparent); border-color: var(--accent); opacity: 1; }
        .step[data-step="1"] { grid-column: 3; }
        /* Phone tour: edge-to-edge 4:5 window; the camera script (index.astro) moves the full-size recording inside it */
        .frame { position: relative; overflow: hidden; aspect-ratio: 4 / 5; margin-inline: -16px; background: var(--surface); touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
        .frame .player { position: absolute; top: 0; left: 0; width: 1408px; max-width: none; height: 790px; border: 0; transform-origin: 0 0; transition: transform 2s ease-in-out; }
        .tour-bar { display: flex; position: absolute; z-index: 1; inset: 8px 10px auto; gap: 3px; }
        .tour-bar span { height: 3px; background: color-mix(in srgb, var(--muted) 35%, transparent); }
        .tour-bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width 0.25s linear; }
      }
      @keyframes caption-in { from { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .frame .player { transition: none; } .screens li { animation: none; } }

      .lead { font-size: 1.15rem; font-weight: 600; }
      .muted { color: var(--muted); }
      .cta a { font-size: 1.15rem; font-weight: 600; }
      .cta span { display: block; color: var(--muted); }
      code, pre { font-family: var(--mono); font-size: 0.9em; }
      pre { overflow-x: auto; padding: 1rem; background: var(--surface); border: 1px solid var(--line); }
      .table-wrap { overflow-x: auto; margin: 1rem 0; }
      table { border-collapse: collapse; font-size: 0.9rem; }
      caption { text-align: left; font-weight: 600; padding-bottom: 0.5rem; }
      th, td { padding: 0.3rem 0.6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
      td strong { color: var(--accent); }
      .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div>
        <a class="wordmark" href={`${base}/`}>
          <span class="word">XMR<span>4</span>EL</span>
          <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-linecap="round" stroke-width="3">
              <path d="M38.75 14.64 18.25 27.36M43 17v8M40.39 34.27 32 48" />
              <circle cx="43" cy="12" r="5" /><circle cx="14" cy="30" r="5" /><circle cx="43" cy="30" r="5" />
            </g>
            <rect x="27" y="43.5" width="10" height="10" fill="currentColor" />
          </svg>
        </a>
        <nav aria-label="Site">
          <div class="sections">
            <a href={`${base}/#what`}>What</a>
            <a href={`${base}/#how`}>How</a>
            <a href={`${base}/#results`}>Results</a>
            <a href={`${base}/#try`}>Try</a>
            <a href={`${base}/#cite`}>Cite</a>
          </div>
          <div class="ext">
            <a href={`${base}/benchmarks/`}>Benchmarks</a>
            <a href="https://github.com/lasigeBioTM/XMR4EL" target="_blank" rel="noopener">GitHub</a>
          </div>
        </nav>
        <button id="theme-toggle" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="glass" d="M12 2.5a6.5 6.5 0 0 0-3.8 11.8c.7.5 1.3 1.3 1.3 2.2v.5h5v-.5c0-.9.6-1.7 1.3-2.2A6.5 6.5 0 0 0 12 2.5z" />
            <path d="M9.5 19.5h5M10.5 22h3" />
          </svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <script is:inline>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const label = () => toggle.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Turn the lights on' : 'Turn the lights off');
      label();
      toggle.addEventListener('click', () => {
        const swap = async () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          label();
          // Pages push promises here (the home recording swap); the fade waits for them, at most 1 s
          const waits = [];
          document.dispatchEvent(new CustomEvent('themechange', { detail: waits }));
          await Promise.race([Promise.all(waits), new Promise((r) => setTimeout(r, 1000))]);
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) swap();
        else document.startViewTransition(swap);
      });

      // Highlight the section link for the part of the home page in view
      const links = [...document.querySelectorAll('.sections a')];
      const targets = links.map((a) => document.getElementById(a.hash.slice(1)));
      const mark = () => {
        let cur;
        targets.forEach((s, i) => { if (s && s.getBoundingClientRect().top < innerHeight / 3) cur = links[i]; });
        if (cur && innerHeight + scrollY >= document.documentElement.scrollHeight - 2) cur = links.at(-1);
        links.forEach((a) => (a === cur ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      };
      addEventListener('scroll', mark, { passive: true });
      mark();
    </script>
  </body>
</html>
