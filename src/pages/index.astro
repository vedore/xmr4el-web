---
import Base from '../layouts/Base.astro';
import ex from '../data/home-examples.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Test Acc@1 from the results table below (validation run of 2 November 2026)
const systems = ['XMR4EL', 'SapBERT 1-NN', 'Character TF-IDF 1-NN', 'PECOS XR-Linear'];
const acc = { 'NCBI-disease': [89.5, 87.4, 82.6, 82.8], 'BC5CDR-chemical': [93.3, 95.2, 96.1, 81.2] };

// Split a sentence around whole-word occurrences of a mention; odd parts are the mention
const parts = (text, m) => text.split(new RegExp(`\\b(${m})\\b`));
const we = ex.worked_example;

// Illustrative beam search: root, 3 clusters, 9 leaves. k = kept by the beam, x = dropped, win = final leaf
const nodes = [{ x: 180, y: 14, cls: 'root' }];
[60, 180, 300].forEach((x, i) => nodes.push({ x, y: 70, p: 0, cls: i < 2 ? 'k1' : 'x1' }));
['x2', 'x2', 'k2', 'k2 win', 'x2', 'x2', 'x1', 'x1', 'x1'].forEach((cls, i) =>
  nodes.push({ x: 20 + 40 * i, y: 126, p: 1 + Math.floor(i / 3), cls, leaf: true }));
---
<Base>
  <section id="demo" class="wide">
    <p class="eyebrow wip">Work in progress.</p>
    <h1>Linking biomedical mentions to the concepts they actually mean.</h1>
    <p class="sub">
      XMR4EL treats entity linking as extreme multi-label ranking: a learned tree of concepts decides which
      of thousands of IDs are worth ranking for each mention. It is open research software for finding out where that helps,
      and where a nearest-neighbour lookup was enough all along.
    </p>
    <p class="eyebrow look">Runs in your terminal, locally, no browser needed.</p>
    <div class="stage">
      <!-- TUI recording: Notebook (dark) / Notebook light, swapped with the theme -->
      <div class="frame">
        <div class="tour-bar" aria-hidden="true"></div>
        <video class="player" muted loop playsinline aria-label="Recording of the XMR4EL terminal UI"></video>
      </div>
      <div class="showcase">
        <p class="eyebrow">Terminal UI</p>
        <!-- Descriptions from XMR4EL docs/TUI.md. Buttons seek the recording. -->
        <button type="button" class="step" data-step="-1" aria-label="Previous screen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg></button>
        <ol class="screens">
          <li><button type="button" aria-current="true"><b data-n="01">Dashboard</b><small>Every saved tree, grouped by dataset, with its evaluations and any runs still going.</small></button></li>
          <li><button type="button"><b data-n="02">Results</b><small>Pin a baseline, add challengers. Deltas appear only when the runs are actually comparable.</small></button></li>
          <li><button type="button"><b data-n="03">Dataset Setup</b><small>Pick a recognised dataset or register your own PubTator files, then map the splits.</small></button></li>
          <li><button type="button"><b data-n="04">Model Builder</b><small>Configure one or more trees; each edit is validated before it is applied.</small></button></li>
          <li><button type="button"><b data-n="05">Review Batch</b><small>See how the trees differ, fix issues, launch. Launching takes two keypresses, on purpose.</small></button></li>
          <li><button type="button"><b data-n="06">Batch Monitor</b><small>Execution order, the selected tree's live log, and a Stop that asks first.</small></button></li>
          <li><button type="button"><b data-n="07">Run Monitor</b><small>One run's pipeline stages, resource use and live log, stage by stage.</small></button></li>
        </ol>
        <button type="button" class="step" data-step="1" aria-label="Next screen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
      </div>
    </div>
    <script is:inline define:vars={{ base }}>
      const v = document.querySelector('.player');
      // Reduced motion: no autoplay; click toggles play/pause either way
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      v.autoplay = !reduce;
      const phone = matchMedia('(max-width: 760px)');
      v.addEventListener('click', () => phone.matches || (v.paused ? v.play() : v.pause()));
      const pick = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        const src = `${base}/recordings/xmr4el-tui-demo-notebook${dark ? '' : '-light'}.mp4`;
        if (v.getAttribute('src') === src) return;
        // Theme swap: resume the new recording where the old one was, playing or paused
        const at = v.currentTime, playing = !v.paused;
        v.src = src;
        // Resolves once the new recording shows the same frame, so the theme fade has no blank video
        if (at) return new Promise((done) => v.addEventListener('loadedmetadata', () => {
          v.addEventListener('seeked', done, { once: true });
          v.currentTime = at;
          playing ? v.play() : v.pause();
        }, { once: true }));
      };
      pick();
      document.addEventListener('themechange', (e) => e.detail.push(pick()));

      // [start second, screen list index]; gaps between screens keep the previous highlight
      const segments = [[0, 0], [3.8, 1], [14.4, 2], [19.4, 3], [30.76, 4], [36.36, 5], [40.36, 6], [54.36, 5], [58.36, 0]];
      const items = [...document.querySelectorAll('.screens button')];
      items.forEach((b, i) => b.addEventListener('click', () => {
        v.currentTime = segments.find(([, j]) => j === i)[0];
        v.play();
      }));
      // Previous / next part of the recording (screens that come back, like Batch Monitor, count twice)
      const step = (d) => {
        const i = segments.findLastIndex(([t]) => t <= v.currentTime);
        v.currentTime = segments[(i + d + segments.length) % segments.length][0];
        v.play();
      };
      document.querySelectorAll('.step').forEach((s) => s.addEventListener('click', () => step(+s.dataset.step)));
      // Phones: swipe the caption left / right for the next / previous screen
      let x0;
      const box = document.querySelector('.screens');
      box.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
      });

      // Phone tour: a 4:5 window onto the recording, panned and zoomed like a camera. Zoomed in by default; W only where the whole TUI matters.
      // Shots are [second, centre x, centre y, width] in recording pixels (1408×790); W = the whole TUI.
      const END = 62; // recording length (s)
      const W = [704, 395, 1408];
      const shots = [
        [0, ...W], [0.8, 240, 300], // Dashboard: explorer
        [7.5, 760, 350, 560], [10, 1134, 350, 548], // Results: summary with every tree's Acc@1, then the other trees' columns
        [12.2, 240, 300], [16.8, 660, 300], // Dataset Setup: head left as Results ends, so the dataset list is framed when it appears; then split mapping
        [19.4, ...W], [23.2, 240, 490], [27.4, ...W], // Model Builder: whole pipeline (copy tree, walk to Matcher), the C edit, then the applied result
        [31.6, 745, 300, 640], [34, 240, 490], // Review Batch: the difference, then launch
        [37.2, 240, 300], // Batch Monitor: queue
        [41.2, 240, 400], [47.6, 240, 300], [50.6, 240, 400], // Run Monitor: stages, full-screen log, stages
        [55.2, 720, 490], // Batch Monitor: evaluation results
        [59.2, 570, 490], [61.2, ...W], // Dashboard: active runs
      ];
      const frame = document.querySelector('.frame');
      let shot;
      const aim = (force) => {
        if (!phone.matches) return (v.style.transform = '');
        const s = shots.findLast(([t]) => t <= v.currentTime);
        if (s === shot && !force) return;
        shot = s;
        const [, cx, cy, w = 480] = s;
        const F = frame.clientWidth, H = frame.clientHeight, k = F / w;
        // Centre (cx, cy) without showing past the recording's edges; centre the recording if it's smaller than the frame
        const fit = (c, size, view) => (size * k <= view ? (view - size * k) / 2 : Math.min(0, Math.max(view - size * k, view / 2 - c * k)));
        v.style.transform = `translate(${fit(cx, 1408, F)}px, ${fit(cy, 790, H)}px) scale(${k})`;
      };
      addEventListener('resize', () => aim(true));
      v.addEventListener('seeked', () => aim());

      // Progress bar: one piece per part of the recording, sized by its length
      const bar = document.querySelector('.tour-bar');
      const span = (i) => [segments[i][0], segments[i + 1]?.[0] ?? END];
      bar.innerHTML = segments.map((_, i) => `<span style="flex:${span(i)[1] - span(i)[0]}"><i></i></span>`).join('');
      const fills = [...bar.querySelectorAll('i')];

      // Phones: tap the left / right half of the frame for the previous / next part; hold to pause
      let timer, held;
      frame.addEventListener('pointerdown', () => {
        if (!phone.matches) return;
        held = false;
        timer = setTimeout(() => { held = !v.paused; v.pause(); }, 300);
      });
      frame.addEventListener('pointercancel', () => clearTimeout(timer));
      frame.addEventListener('pointerup', (e) => {
        if (!phone.matches) return;
        clearTimeout(timer);
        if (held) return v.play();
        const r = frame.getBoundingClientRect();
        step(e.clientX < r.left + r.width / 2 ? -1 : 1);
      });

      v.addEventListener('timeupdate', () => {
        const cur = items[segments.findLast(([t]) => t <= v.currentTime)[1]];
        items.forEach((b) => b.toggleAttribute('aria-current', b === cur));
        fills.forEach((f, i) => {
          const [a, b] = span(i);
          f.style.width = `${Math.min(1, Math.max(0, (v.currentTime - a) / (b - a))) * 100}%`;
        });
        aim();
      });
      aim();
    </script>
  </section>

  <section id="what">
    <h2>What it does.</h2>
    <p class="lead">“AS” goes in. <code>MESH:D013167</code> comes out. Ideally.</p>
    <p>
      Entity linking maps a mention in text to an identifier in a vocabulary such as MeSH or UMLS, so every
      way of writing a concept ends up at the same ID. XMR4EL frames it as extreme multi-label ranking:
      each concept is a label, and the model ranks them for a mention using the mention and the words
      around it.
    </p>
    <p>It links mentions you already have. Finding them in the text is a separate step, outside this project.</p>
    <!-- Worked example from src/data/home-examples.json -->
    <figure class="example">
      <p class="eyebrow">Example · NCBI-disease test set, PMID {we.source.doc_id}.</p>
      <blockquote>{parts(we.sentence, we.mention).map((t, i) => (i % 2 ? <mark>{t}</mark> : t))}</blockquote>
      <p class="query"><span>Query</span> {we.query}</p>
      <ol>
        {we.candidates.map((c) => (
          <li class:list={{ gold: c.id === we.gold.id }}>
            <span class="rank">{c.rank}</span>
            <span>{c.name} <code>{c.id}</code>{c.id === we.gold.id && <small>gold</small>}</span>
            <span class="num">{Math.round(c.score).toLocaleString('en')}</span>
          </li>
        ))}
      </ol>
      <figcaption>
        In the training data, “AS” is close to a coin toss: 10 annotations say ankylosing spondylitis, 11
        say Angelman syndrome. Most of the credit goes to the abstract, which spelled out “ankylosing
        spondylitis (AS)” earlier; preprocessing appends that expansion to the query shown above. Scores
        are raw ranking scores, comparable only within one query.
      </figcaption>
    </figure>
  </section>

  <section id="where" class="band">
    <h2>Where it helps.</h2>
    <p class="lead">Biomedical names are many-to-many. That is the whole problem.</p>
    <p>
      In one corpus, a single disease turns up under at least four names, and a single abbreviation names
      two different diseases. Both cards below are straight from NCBI-disease gold annotations.
    </p>
    <p>
      XMR4EL is built for studying that mess: combine representations, train label hierarchies, change
      ranking settings, and compare the results on annotated corpora.
    </p>
    <!-- Examples from src/data/home-examples.json (NCBI-disease gold annotations) -->
    <div class="cards">
      <article>
        <h3>One concept, many names</h3>
        <p>{ex.same_concept.concept.name} <code>{ex.same_concept.concept.id}</code></p>
        <ul class="forms">
          {ex.same_concept.surface_forms.map((f) => <li><span>{f.text}</span><span class="num">{f.count}</span></li>)}
        </ul>
        <p class="src">Gold annotation counts, NCBI-disease {ex.same_concept.source.splits.join(' + ')}</p>
      </article>
      <article>
        <h3>One name, many concepts</h3>
        {ex.same_name.senses.map((s) => (
          <figure>
            <blockquote>{parts(s.context, ex.same_name.surface_form).map((t, i) => (i % 2 ? <mark>{t}</mark> : t))}</blockquote>
            <figcaption>{s.name} <code>{s.id}</code></figcaption>
          </figure>
        ))}
        <p class="src">NCBI-disease, PMIDs {ex.same_name.senses.map((s) => s.doc_id).join(', ')}</p>
      </article>
    </div>
  </section>

  <section id="how">
    <h2>How it works.</h2>
    <p class="lead">Organise the concepts into a tree. Search only the promising branches.</p>
    <ol class="pipeline">
      <li>
        <h3>Read the data.</h3>
        <p>Load annotated mentions with a configurable window of surrounding words, expanding abbreviations the document defines.</p>
      </li>
      <li>
        <h3>Encode the text.</h3>
        <p>
          By default, three views side by side: SapBERT mention embeddings, character TF-IDF for spelling,
          and TF-IDF over the context words.
        </p>
      </li>
      <li>
        <h3>Build the hierarchy.</h3>
        <p>Aggregate each concept's training texts into a label embedding (PIFA) and cluster the labels into a tree.</p>
      </li>
      <li>
        <h3>Train the rankers.</h3>
        <p>Train a matcher at each node: upper ones route queries down the tree, leaf ones rank the concepts.</p>
      </li>
      <li>
        <h3>Retrieve candidate concepts.</h3>
        <p>
          Beam search keeps the best branches, then candidates are reweighted by similarity to training
          mentions. Turning that off costs up to 34 points of Acc@1 (<a href={`${base}/benchmarks/#ablation`}>ablation</a>).
        </p>
      </li>
    </ol>
    <div class="tree-fig">
    <svg class="tree" viewBox="0 0 360 140" role="img" aria-label="Illustration: beam search through the label tree, narrowing to one leaf">
      {nodes.filter((n) => n.p !== undefined).map((n) => (
        <line class={n.cls} x1={nodes[n.p].x} y1={nodes[n.p].y} x2={n.x} y2={n.y} />
      ))}
      {nodes.map((n) => n.leaf
        ? <rect class={n.cls} x={n.x - 7} y={n.y - 7} width="14" height="14" />
        : <circle class={n.cls} cx={n.x} cy={n.y} r="7" />)}
    </svg>
    <!-- Step captions are working copy -->
    <p class="tree-cap" aria-hidden="true"></p>
    </div>
    <script is:inline>
      const tree = document.querySelector('.tree');
      const cap = document.querySelector('.tree-cap');
      const caps = [
        'Beam search through the label tree',
        '1/4 · The query enters at the root.',
        '2/4 · The beam keeps the best-scoring clusters.',
        '3/4 · Under those, it keeps the best-scoring leaves.',
        '4/4 · The top-ranked concept is returned.',
      ];
      const show = (s) => {
        for (let i = 1; i <= 4; i++) tree.classList.toggle('s' + i, i <= s);
        cap.textContent = caps[Math.min(s, 4)];
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) show(4);
      else { let s = 0; show(0); setInterval(() => show((s = (s + 1) % 6)), 1800); }
    </script>
  </section>

  <section id="now" class="band">
    <h2>What it accomplishes today.</h2>
    <p class="lead">It runs end to end today, from training file to a comparison you can defend.</p>
    <div class="cards">
      <article>
        <h3>Train &amp; evaluate</h3>
        <p>
          Train and save a tree, rank candidates and score held-out data, from command-line scripts or the
          Python API. Reports Acc@1, MRR, recall@k and candidate recall.
        </p>
      </article>
      <article>
        <h3>A terminal UI with standards</h3>
        <p>
          Optional. Configure experiment batches, watch them run, and compare evaluations. It withholds
          deltas when the evidence says two runs aren't comparable, which is more than most spreadsheets do.
        </p>
      </article>
      <article>
        <h3>Runs that keep receipts</h3>
        <p>
          Runs launched through the experiment runner or the UI record configuration, input hashes, code
          state, package versions and metrics. Future you will want to know which config that was.
        </p>
      </article>
    </div>
    <p class="muted scope">
      Not included: mention detection, a knowledge-base lookup service or a serving API. A cross-encoder
      reranker exists, but it is experimental and separate from the main prediction path.
    </p>
  </section>

  <section id="results">
    <h2>How well it does.</h2>
    <p class="lead">Best of four on diseases. Beaten by nearest neighbours on chemicals.</p>
    <p>
      The 2 November 2026 benchmark runs one model configuration on NCBI-disease and BC5CDR-chemical,
      against two nearest-neighbour baselines and PECOS XR-Linear.
    </p>
    <!-- Same numbers as the table below, which is the accessible view -->
    <div class="chart" aria-hidden="true">
      {Object.entries(acc).map(([name, vals]) => (
        <div>
          <p>{name}</p>
          {systems.map((sys, i) => (
            <div class:list={['row', { x: i === 0 }]}>
              <span>{sys}</span>
              <span class="bar" style={`--v: ${vals[i]}`}></span>
              <span class="val">{vals[i]}%</span>
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="table-wrap" role="region" aria-labelledby="results-caption" tabindex="0">
      <table>
        <caption id="results-caption">Test Acc@1, validation run of 2 November 2026 (highest model score in bold)</caption>
        <thead>
          <tr>
            <th scope="col">Test dataset</th>
            <th scope="col" class="num">Kept / loaded rows</th>
            <th scope="col" class="num">Vocabulary coverage</th>
            <th scope="col" class="num">XMR4EL</th>
            <th scope="col" class="num">SapBERT 1-NN</th>
            <th scope="col" class="num">Character TF-IDF 1-NN</th>
            <th scope="col" class="num">PECOS XR-Linear</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">NCBI-disease</th>
            <td class="num">923 / 945</td>
            <td class="num">97.7%</td>
            <td class="num"><strong>89.5%</strong></td>
            <td class="num">87.4%</td>
            <td class="num">82.6%</td>
            <td class="num">82.8%</td>
          </tr>
          <tr>
            <th scope="row">BC5CDR-chemical</th>
            <td class="num">5,167 / 5,352</td>
            <td class="num">96.5%</td>
            <td class="num">93.3%</td>
            <td class="num">95.2%</td>
            <td class="num"><strong>96.1%</strong></td>
            <td class="num">81.2%</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Where XMR4EL earns its keep on both datasets is ambiguity. On mentions seen in training with more
      than one label, it beats SapBERT 1-NN on the test sets: 0.818 vs 0.394 on NCBI-disease, 0.811 vs
      0.649 on BC5CDR-chemical. Those groups hold only 33 and 111 mentions, so read them as a lead, not a
      verdict.
    </p>
    <p>
      Scores cover mentions whose concept has training text, so they are not directly comparable with
      published numbers that score every mention against a full ontology.
    </p>
    <p class="cta">
      <a href={`${base}/benchmarks/`}>Read the full benchmark</a>
      <span>
        Every metric, the reweighting ablation, run costs, the limitations we know about, and how to
        reproduce it.
      </span>
    </p>
  </section>

  <section id="try" class="band">
    <h2>Try it.</h2>
    <p class="lead">Four commands to the terminal UI. Datasets not included.</p>
    <p>
      You need Python 3.12+ and uv. The first transformer run downloads SapBERT from Hugging Face unless
      you already have it cached.
    </p>
    <div class="code">
    <pre><code>git clone https://github.com/lasigeBioTM/XMR4EL.git
cd XMR4EL
uv sync --locked --extra tui
.venv/bin/python -m xmr4el_tui</code></pre>
      <button type="button" class="copy">Copy</button>
    </div>
    <script is:inline>
      document.querySelector('.copy').addEventListener('click', async (e) => {
        const b = e.currentTarget;
        try {
          await navigator.clipboard.writeText(b.previousElementSibling.textContent);
          b.textContent = 'Copied';
        } catch {
          b.textContent = 'Copy failed';
        }
        setTimeout(() => (b.textContent = 'Copy'), 1500);
      });
    </script>
    <p>
      Bring your own corpora as local PubTator files. In the UI, pick a dataset, build a model
      configuration and launch; Run Monitor shows each pipeline stage as it happens.
    </p>
    <p>
      The <a href="https://github.com/lasigeBioTM/XMR4EL#readme" target="_blank" rel="noopener">README</a> covers
      dataset preparation, command-line training and evaluation, the Python API and Docker.
    </p>
  </section>

  <section id="cite">
    <h2>Who made it &amp; how to cite.</h2>
    <p class="lead">Open source under MIT. Issues welcome; bugs less so.</p>
    <p>
      XMR4EL was created by João Vedor and is hosted in the lasigeBioTM GitHub organisation.
    </p>
    <p>
      If you use it in research, cite the repository with the exact commit, plus your model configuration
      and dataset protocol. The numbers depend on all three.
    </p>
    <ul>
      <li><a href="https://github.com/lasigeBioTM/XMR4EL" target="_blank" rel="noopener">Repository</a></li>
      <li><a href="https://github.com/lasigeBioTM/XMR4EL/issues" target="_blank" rel="noopener">Issues</a></li>
      <li><a href="https://github.com/lasigeBioTM/XMR4EL/blob/main/LICENSE" target="_blank" rel="noopener">Licence</a></li>
    </ul>
  </section>
</Base>

<style>
  .wip { color: var(--accent); margin: 2.5rem 0 0.6rem; }
  .wip + h1 { margin-top: 0; }
  .look { color: var(--accent); }
  #demo h1:has(+ .sub) { margin-bottom: 0.75rem; }
  .sub { max-width: 62ch; margin: 0 0 2rem; font-size: 1.15rem; color: var(--muted); }
  .scope { margin: 1rem 0 0; font-size: 0.9rem; }
  /* Section rhythm: numbered mono eyebrow (the h2), lead as the headline, alternating full-bleed bands */
  #demo { counter-reset: sec; margin-bottom: 0; }
  section:not(#demo) { counter-increment: sec; margin-block: 0; padding-block: 3.5rem; }
  section:not(#demo) > h2 {
    font: 600 1.05rem var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 0.75rem;
  }
  section:not(#demo) > h2::before { content: counter(sec, decimal-leading-zero) '\2002' / ''; color: var(--accent); }
  section .lead { font-size: clamp(1.45rem, 3.2vw, 2rem); line-height: 1.2; max-width: 30ch; margin: 0 0 1.25rem; }
  .band { background: var(--surface); box-shadow: 0 0 0 100vmax var(--surface); clip-path: inset(0 -100vmax); }
  .band pre, .band article { background: var(--bg); }

  /* How it works: left-to-right pipeline, wider than the text column */
  .pipeline {
    list-style: none; padding: 0; counter-reset: step;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.75rem;
    margin: 2rem calc(50% - min(42rem, 50cqi));
  }
  .pipeline li { position: relative; counter-increment: step; padding: 1rem; background: var(--surface); border: 1px solid var(--line); }
  .pipeline li + li::before {
    content: '→' / ''; position: absolute; left: -1.75rem; top: 50%; transform: translateY(-50%); width: 1.75rem; text-align: center; color: var(--accent); font-family: var(--mono);
  }
